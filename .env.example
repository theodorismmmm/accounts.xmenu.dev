# Required environment variables for the API functions
# Copy this file to .env.local and fill in your values.
# Never commit .env.local or any file containing real secrets.

# Your Supabase project URL (found in Supabase dashboard → Settings → API)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anonymous/public key (safe to use in serverless functions for auth)
SUPABASE_ANON_KEY=eyJ...

# Supabase service-role key (used ONLY by api/delete-user.js — keep secret!)
SUPABASE_SERVICE_ROLE_KEY=eyJ...
